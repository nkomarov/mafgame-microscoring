{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/observer/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/observer/?",
      "dest": "web/observer/index.html"
    },
    {
      "src": "/",
      "dest": "web/observer/index.html"
    }
  ]
}
